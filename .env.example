# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. NEVER commit real credentials.
# All variables below are OPTIONAL for the foundation stage: the app builds,
# boots and reports its integration status without any of them.
# ---------------------------------------------------------------------------

# --- Public configuration (exposed to the browser; NEXT_PUBLIC_ prefix) ----
NEXT_PUBLIC_APP_NAME="Personal AI Assistant"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI provider (server-only, OpenAI-compatible chat completions API) ------
# Example base URLs: https://api.groq.com/openai/v1 , https://openrouter.ai/api/v1
# Set AI_MODEL to a real, current model id from your provider's model list.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_PROVIDER_NAME="openai-compatible"

# Optional allow-list shown in the model selector. Use `id|Label` for a
# friendly name. AI_MODEL is always included, even when omitted here.
# Example: AI_MODELS="model-a|Fast,model-b|Reasoning"
AI_MODELS=""
# Optional subset of the above ids that accept image attachments. The UI marks
# these as vision-capable; other models may still reject image parts upstream.
AI_VISION_MODELS=""

AI_MAX_OUTPUT_TOKENS="1024"
AI_REQUEST_TIMEOUT_MS="30000"

# --- Database (server-only) ------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security: server-only, never
# expose it with a NEXT_PUBLIC_ prefix and never ship it inside the APK.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Runtime ---------------------------------------------------------------
LOG_LEVEL="info"
